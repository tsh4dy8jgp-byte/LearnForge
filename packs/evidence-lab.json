  "scenarios": [
    {
      "id": "reading",
      "title": "The reading club report",
      "background": "A library ran a four-week reading club. Thirty people volunteered. Afterward, 24 reported reading more often. No comparison group was used. A poster claimed the club made everyone a regular reader."
    },
    {
      "id": "planning",
      "title": "The planning workshop report",
      "background": "A university offered a planning workshop to twenty volunteers. Afterward, 18 reported meeting more deadlines. No comparison group was used. The organizer claimed the workshop caused the improvement."
    }
