{
  "schemaVersion": 1,
  "id": "evidence-lab",
  "version": "1.0.0",
  "title": "Evidence lab",
  "description": "Read a claim, question its evidence, and practise careful conclusions in two case studies.",
  "license": "CC0-1.0",
  "objectives": [
    {
      "id": "evaluate",
      "title": "Evaluate claims against evidence",
      "prerequisites": []
    }
  ],
  "lessons": [
    {
      "id": "evidence-first",
      "title": "From claim to justified conclusion",
      "summary": "Separate observation, explanation and uncertainty.",
      "objectiveIds": [
        "evaluate"
      ],
      "blocks": [
        {
          "kind": "text",
          "text": "A claim states what someone believes. Evidence is an observation that can support or challenge it. An observed improvement does not, by itself, establish its cause."
        },
        {
          "kind": "example",
          "title": "A careful conclusion",
          "text": "Thirty volunteers reported better sleep after a course. This supports a statement about those reports. Without a comparable group, it does not establish that the course caused the change."
        },
        {
          "kind": "callout",
          "title": "A four-step review",
          "text": "Define the claim. Inspect the study design and observations. Identify limitations. State a conclusion with appropriate uncertainty."
        }
      ]
    }
  ],
  "questions": [
    {
      "id": "reading-claim",
      "familyId": "reading-claim",
      "kind": "single",
      "prompt": "Which statement is directly supported by the reading club report?",
      "objectiveIds": [
        "evaluate"
      ],
      "options": [
        {
          "id": "supported",
          "text": "24 volunteers reported an improvement."
        },
        {
          "id": "cause",
          "text": "The program caused improvement in every participant."
        },
        {
          "id": "universal",
          "text": "Everyone will benefit equally."
        }
      ],
      "slots": [],
      "selectCount": 1,
      "reuse": false,
      "grading": {
        "policy": "exact",
        "correct": [
          "supported"
        ]
      },
      "explanation": "A reported observation is supported. Causation and universal benefits require additional evidence.",
      "scenarioId": "reading",
      "weight": 1
    },
    {
      "id": "reading-limits",
      "familyId": "reading-limits",
      "kind": "multiple",
      "prompt": "Select TWO limitations of this study.",
      "objectiveIds": [
        "evaluate"
      ],
      "options": [
        {
          "id": "control",
          "text": "No comparison group was used."
        },
        {
          "id": "selection",
          "text": "Participants volunteered."
        },
        {
          "id": "sample",
          "text": "No participants were studied."
        },
        {
          "id": "random",
          "text": "Random allocation removed selection bias."
        },
        {
          "id": "none",
          "text": "The report proves universal effectiveness."
        }
      ],
      "slots": [],
      "selectCount": 2,
      "reuse": false,
      "grading": {
        "policy": "partial",
        "correct": [
          "control",
          "selection"
        ]
      },
      "explanation": "Volunteer selection limits generalization; without a comparison group, other explanations remain.",
      "scenarioId": "reading",
      "weight": 1
