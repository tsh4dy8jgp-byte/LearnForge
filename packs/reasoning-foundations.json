    "schemaVersion": 1,
    "id": "reasoning-foundations",
    "version": "1.0.0",
    "title": "Reasoning foundations",
    "description": "A compact, original course in sets, logic and ordered reasoning. Explore every LearnForge question format before creating your own subject pack.",
    "license": "CC0-1.0",
    "objectives": [
      {
        "id": "sets",
        "title": "Reason about sets and membership",
        "prerequisites": []
      },
      {
        "id": "logic",
        "title": "Evaluate statements and logical rules",
        "prerequisites": [
          "sets"
        ]
      },
      {
        "id": "ordering",
        "title": "Follow and explain ordered procedures",
        "prerequisites": [
          "logic"
        ]
      }
    ],
    "lessons": [
      {
        "id": "sets-intro",
        "title": "Think in sets",
        "summary": "Describe collections, membership and overlap.",
        "objectiveIds": [
          "sets"
        ],
        "blocks": [
          {
            "kind": "text",
            "text": "A set is a collection of distinct elements. Order does not matter: {1, 2} and {2, 1} describe the same set."
          },
          {
            "kind": "example",
            "title": "Union and intersection",
            "text": "For A = {1, 2} and B = {2, 3}, the union A ∪ B is {1, 2, 3}. The intersection A ∩ B is {2}, because 2 belongs to both."
          },
          {
            "kind": "callout",
            "title": "A common mistake",
            "text": "Union means either collection; intersection means both. Drawing two overlapping circles can help you separate the ideas."
          }
        ]
      },
      {
        "id": "logic-intro",
        "title": "Build logical statements",
        "summary": "Evaluate AND and OR using truth values.",
        "objectiveIds": [
          "logic"
        ],
        "blocks": [
          {
            "kind": "text",
            "text": "A logical statement has a truth value: true or false. AND is true only when both operands are true. Inclusive OR is true when at least one operand is true."
          },
          {
            "kind": "example",
            "title": "Evaluate one step at a time",
            "text": "Let P be true and Q be false. P AND Q is false. P OR Q is true. Write down the input values before applying the operator."
          },
          {
            "kind": "callout",
            "title": "Check your interpretation",
            "text": "In this course OR is inclusive: both inputs may be true. Everyday language sometimes uses OR to mean exactly one; mathematics distinguishes this as exclusive OR."
          }
        ]
      },
      {
        "id": "ordering-intro",
        "title": "Reason in sequence",
        "summary": "Follow a procedure and check its invariant.",
        "objectiveIds": [
          "ordering"
        ],
        "blocks": [
          {
            "kind": "text",
            "text": "A sequence records order. When sorting numbers increasingly, every adjacent pair must satisfy left ≤ right."
          },
          {
            "kind": "example",
            "title": "Sort a small list",
            "text": "Given 8, 3, 6, 1, choose the smallest remaining value repeatedly: 1, 3, 6, 8. Check that each value appears exactly once."
          },
          {
            "kind": "code",
            "title": "A check in pseudocode",
            "text": "for each adjacent pair (left, right):\n    require left <= right\nrequire output has the same elements as input"
          }
        ]
      }
    ],
